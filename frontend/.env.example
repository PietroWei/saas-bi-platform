# =====================================================================
# Streamlit frontend - environment variables
# Copy this file to frontend/.env for local development.
# On Railway, set the same keys in the service's "Variables" tab.
# =====================================================================

# --- Backend URL ------------------------------------------------------
# Public base URL of the FastAPI backend, no trailing slash.
#
# Local Docker Compose (Streamlit container talks to backend container):
#   BACKEND_URL=http://fastapi-backend:8000
#
# Local without Docker (Streamlit on host, FastAPI on host):
#   BACKEND_URL=http://localhost:8000
#
# Railway: set this to the FastAPI service's public URL, e.g.
#   BACKEND_URL=https://fastapi-backend-production.up.railway.app
# Use Railway's "Reference Variable" feature to bind it to the backend
# service URL automatically.
BACKEND_URL=http://localhost:8000

# --- Sample-data fallback --------------------------------------------
# Set to "true" to ignore the live backend and render bundled sample
# data only. Useful for UI work or to demo the app while Supabase is
# still empty. Leave unset (or "false") in production.
USE_SAMPLE_DATA=false
