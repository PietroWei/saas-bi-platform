# =====================================================================
# FastAPI backend - environment variables
# Copy this file to backend/.env for local development.
# On Railway, set the same keys in the service's "Variables" tab.
# =====================================================================

# --- Database ---------------------------------------------------------
# Full Postgres connection string. The backend accepts both libpq-style
# (postgresql://) and SQLAlchemy async-style (postgresql+asyncpg://).
#
# Local Docker Compose:
#   postgresql+asyncpg://bi_user:change_me_strong_password@postgres:5432/bi_platform
#
# Supabase (free tier, transaction pooler is recommended for serverless
# but session/direct connection works too). Grab it from the Supabase
# dashboard: Project Settings -> Database -> Connection string -> URI.
#   postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://bi_user:change_me_strong_password@postgres:5432/bi_platform

# --- App metadata -----------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# --- CORS -------------------------------------------------------------
# Comma-separated list of allowed origins. Use "*" for any origin.
# In production prefer the Streamlit public URL only, e.g.
#   CORS_ORIGINS=https://streamlit-frontend-production.up.railway.app
CORS_ORIGINS=*
