# ======================================================================
# SaaS BI Platform — environment variables
# Copy this file to `.env` and fill in the real values before `docker compose up`.
# ======================================================================

# --- PostgreSQL ---
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=bi_platform
# Secondary DB used by Airflow metadata (created by init script)
AIRFLOW_DB=airflow

# --- Airflow ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace_with_fernet_key_generated_locally
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=replace_with_random_32_byte_hex
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# --- External APIs (all optional — pipelines degrade gracefully if missing) ---
# GitHub personal access token (public_repo scope is enough)
GITHUB_TOKEN=
# Crunchbase-style endpoint — using a free mirror by default
CRUNCHBASE_API_BASE=https://api.crunchbase.com/api/v4
CRUNCHBASE_API_KEY=

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
